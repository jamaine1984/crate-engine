    </div>
    <div class="feature scene-card" data-scene="shipwreck cove" style="cursor:pointer">
      <h3>⚓ Shipwreck Cove</h3>
      <p>Wrecked ships, rocky shore, treasure, docks, skeletons, tropical palms</p>
      <span class="tag">50+ objects</span>
    </div>
  </div>
</div>

<script>
document.querySelectorAll('.scene-card').forEach(card => {
  card.addEventListener('click', () => {
    const scene = card.dataset.scene;
    const input = document.getElementById('prompt-input');
    if (input) {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      setTimeout(() => {
        input.value = 'build a ' + scene;
        input.dispatchEvent(new KeyboardEvent('keydown', { key: 'Enter' }));
        input.value = '';
      }, 500);
    }
  });
});
</script>

<!-- Comparison -->
<div class="comparison" id="compare">

<!-- Pricing -->
