      <div style="color:#555;font-size:0.8rem;margin-bottom:16px">cancel anytime</div>
      <div style="font-size:0.78rem;color:#aaa;line-height:2">
        ✅ Everything in Free<br>
        ✅ 200+ premium models<br>
        ✅ Unlimited AI prompts<br>
        ✅ Export (no watermark)<br>
        🔜 Publish to .com <span style="color:#555;font-size:0.65rem">(coming soon)</span><br>
        ✅ Priority support
      </div>
      <button onclick="window._showUpgradeModal?window._showUpgradeModal('pro'):alert('Engine loading...')" style="width:100%;margin-top:16px;padding:12px;background:#ff6b35;color:#000;border:none;border-radius:10px;font-weight:700;font-size:0.9rem;cursor:pointer;font-family:'JetBrains Mono',monospace">⚡ Go Pro</button>
    </div>
    <div style="flex:1;min-width:250px;max-width:300px;background:#111;border:2px solid #f7c948;border-radius:16px;padding:24px;position:relative">
      <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#f7c948;color:#000;font-size:0.65rem;font-weight:700;padding:4px 12px;border-radius:20px;text-transform:uppercase;letter-spacing:1px">Best Value</div>
      <div style="font-size:0.7rem;color:#f7c948;text-transform:uppercase;letter-spacing:2px;margin-bottom:4px">Premium</div>
      <div style="font-size:2.5rem;font-weight:900;color:#fff;font-family:'JetBrains Mono',monospace">$14.99<span style="font-size:1rem;color:#888">/mo</span></div>
      <div style="color:#555;font-size:0.8rem;margin-bottom:16px">cancel anytime</div>
      <div style="font-size:0.78rem;color:#aaa;line-height:2">
        ✅ Everything in Pro<br>
        ✅ 500+ premium models<br>
        ✅ Custom model uploads<br>
        🔜 Publish to .com <span style="color:#555;font-size:0.65rem">(coming soon)</span><br>
        ✅ Early access features<br>
        ✅ Commercial license
      </div>
      <button onclick="window._showUpgradeModal?window._showUpgradeModal('premium'):alert('Engine loading...')" style="width:100%;margin-top:16px;padding:12px;background:#f7c948;color:#000;border:none;border-radius:10px;font-weight:700;font-size:0.9rem;cursor:pointer;font-family:'JetBrains Mono',monospace">💎 Go Premium</button>
    </div>
  </div>
</div>

  <h2>How We Compare</h2>
  <table class="compare-table">
    <tr><th>Feature</th><th>Crate Engine</th><th>Rosebud AI</th><th>Unity</th></tr>
    <tr><td>Natural language commands</td><td class="check">✓ 800+</td><td class="check">✓ AI chat</td><td class="cross">✗</td></tr>
    <tr><td>Runs in browser</td><td class="check">✓ WebGPU</td><td class="check">✓</td><td class="partial">~ WebGL</td></tr>
    <tr><td>Combat/RPG systems</td><td class="check">✓ 60+ built-in</td><td class="cross">✗</td><td class="partial">~ Plugins</td></tr>
    <tr><td>Real 3D renderer</td><td class="check">✓ wgpu PBR</td><td class="cross">✗ 2.5D</td><td class="check">✓</td></tr>
    <tr><td>Physics engine</td><td class="check">✓ Rapier</td><td class="cross">✗</td><td class="check">✓ PhysX</td></tr>
    <tr><td>No download needed</td><td class="check">✓ 199KB WASM</td><td class="check">✓</td><td class="cross">✗ 2GB+</td></tr>
    <tr><td>Open source</td><td class="check">✓ Rust</td><td class="cross">✗</td><td class="cross">✗</td></tr>
    <tr><td>One-prompt game gen</td><td class="check">✓</td><td class="check">✓</td><td class="cross">✗</td></tr>
  </table>
</div>

