{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crate Engine",
  "version": "1.0.0",
  "identifier": "com.crateshipgames.crateengine",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Crate Engine \u2014 Build Games with AI",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}